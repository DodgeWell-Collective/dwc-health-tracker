# Node server settings (npm run build:node && npm start). Copy to .env.
# Required if the app is reachable by anyone else: the sign-in password.
APP_PASSWORD=
# Where the SQLite database lives (default data/health.sqlite).
DATABASE_PATH=
# Optional: enables "describe it to Claude" and recipe ideas; hidden when empty.
ANTHROPIC_API_KEY=
# Optional: free key from https://api.data.gov/signup (otherwise the rate-limited DEMO_KEY).
USDA_API_KEY=
