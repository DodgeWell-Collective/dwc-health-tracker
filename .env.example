# Node server settings (npm run build:node && npm start). Copy to .env.
# The first sign-in password. Change it later in Settings → Sign-in & keys.
APP_PASSWORD=
# Set to "off" only if something else (a VPN, Cloudflare Access) guards the app.
# With no password and auth on, the app stays locked.
APP_AUTH=
# Where the SQLite database lives (default data/health.sqlite).
DATABASE_PATH=
# Optional, or enter them in Settings: Claude features, and higher USDA search limits.
ANTHROPIC_API_KEY=
USDA_API_KEY=
