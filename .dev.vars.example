# Copy to .dev.vars for local development. Never commit the real file.
# The first sign-in password; change it later in Settings.
APP_PASSWORD=
# "off" skips sign-in (only when something else guards the app).
APP_AUTH=
# Optional, or enter them in Settings: Claude features, and higher USDA search limits.
ANTHROPIC_API_KEY=
USDA_API_KEY=
